rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Koleksi pesan live chat bantuan guru & siswa (ExamFlow Live Chat)
    match /examflow_chat_messages/{messageId} {
      allow read, write: if true;
    }

    // Default deny untuk koleksi lainnya demi keamanan
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
